---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Catalogo publico de servicos da universidade.' } = Astro.props;
const pageTitle = `${title} | SGP`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-mark">SGP</span>
        <span>Catalogo de Servicos</span>
      </a>
      <nav aria-label="Principal">
        <a href="/servicos">Servicos</a>
        <a class="app-link" href={import.meta.env.PUBLIC_APP_BASE_URL || 'http://localhost:4200'}>Acessar sistema</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f7f8fb;
    --surface: #ffffff;
    --muted-surface: #eef1f6;
    --text: #111827;
    --muted: #5b6475;
    --line: #d8dde8;
    --brand: #17316f;
    --brand-strong: #102659;
    --accent: #387a48;
    --accent-soft: #e8f3eb;
    --warning: #c99217;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    align-items: center;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    display: flex;
    gap: 24px;
    justify-content: space-between;
    min-height: 72px;
    padding: 0 32px;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .brand,
  .site-header nav {
    align-items: center;
    display: flex;
    gap: 14px;
  }

  .brand {
    color: var(--brand);
    font-size: 1rem;
    font-weight: 700;
  }

  .brand-mark {
    align-items: center;
    background: var(--brand);
    border-radius: 6px;
    color: #fff;
    display: inline-flex;
    height: 36px;
    justify-content: center;
    letter-spacing: 0;
    width: 48px;
  }

  .site-header nav {
    color: var(--muted);
    font-size: 0.94rem;
    font-weight: 600;
  }

  .app-link {
    background: var(--accent);
    border-radius: 6px;
    color: #fff;
    padding: 10px 14px;
  }

  main {
    min-height: calc(100vh - 72px);
  }

  .page-shell {
    margin: 0 auto;
    max-width: 1180px;
    padding: 36px 24px 56px;
  }

  .hero {
    display: grid;
    gap: 18px;
    margin-bottom: 34px;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    color: var(--brand);
    font-size: clamp(2rem, 4vw, 3.7rem);
    line-height: 1.05;
    margin-bottom: 0;
    max-width: 900px;
  }

  .lead {
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.6;
    max-width: 760px;
  }

  .button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .button {
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 6px;
    display: inline-flex;
    font-weight: 700;
    min-height: 44px;
    padding: 10px 16px;
  }

  .button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .button.secondary {
    background: var(--surface);
    color: var(--brand);
  }

  @media (max-width: 720px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
      padding: 18px 20px;
      position: static;
    }

    .site-header nav {
      width: 100%;
    }

    .app-link {
      margin-left: auto;
    }

    .page-shell {
      padding: 28px 16px 44px;
    }
  }
</style>
